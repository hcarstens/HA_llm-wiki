---
permalink: /sitemap.xml
layout: passthrough
nav_exclude: true
search_exclude: true
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign entries = site.html_pages | sort: "url" -%}
{%- for p in entries -%}
{%- if p.sitemap != false and p.url != "/404.html" -%}
  <url>
    <loc>{{ p.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>
  </url>
{%- endif -%}
{%- endfor -%}
{%- assign llms = site.pages | where: "url", "/llms.txt" | first -%}
{%- if llms -%}
  <url>
    <loc>{{ llms.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ llms.last_modified_at | date_to_xmlschema }}</lastmod>
  </url>
{%- endif -%}
</urlset>
